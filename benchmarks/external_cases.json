{
  "schema_version": "1.0",
  "cases": {
    "micrograd": {
      "status": "ready",
      "repository": "https://github.com/karpathy/micrograd.git",
      "commit": "7bc720e951fe422b8f8814aa5aa1b64121d26b4c",
      "target_subdir": ".",
      "tier": "correctness-canary",
      "rationale": "Small classic autograd repository with a README-documented PyTorch-reference test command.",
      "environment": {
        "system_site_packages": true,
        "dependency_mode": "fresh-venv-with-host-torch-and-pytest",
        "dependency_probes": ["torch", "pytest"],
        "cache_policy": "fresh-checkout-and-venv; host package and network caches retained"
      },
      "setup_steps": [
        {
          "name": "readme-install",
          "argv": ["{python}", "-m", "pip", "install", "--disable-pip-version-check", "micrograd"],
          "timeout_seconds": 180,
          "source": "README Installation",
          "environment": {"PYTHONUTF8": "1"}
        }
      ],
      "known_adaptations": [
        {
          "name": "windows-utf8-mode",
          "environment": {"PYTHONUTF8": "1"},
          "reason": "Observed GBK UnicodeDecodeError when setup.py read the UTF-8 README on Chinese Windows.",
          "scientific_semantics_changed": false
        }
      ],
      "limits": {"max_workspace_mb": 256, "min_free_disk_gb": 5},
      "orchestrator": {
        "expected_command": "python -m pytest",
        "expected_goal": "evaluation",
        "expected_status": "success",
        "expected_stdout_contains": "2 passed",
        "timeout_seconds": 180,
        "include_analysis_pass": true,
        "expected_metrics": []
      }
    },
    "mingpt": {
