        "dependency_probes": ["torch", "transformers"],
        "cache_policy": "fresh checkout and venv; execution intentionally disabled to avoid an unbounded GPT-2 download"
      },
      "setup_steps": [],
      "known_adaptations": [],
      "limits": {"max_workspace_mb": 128, "min_free_disk_gb": 5},
      "orchestrator": {
        "execute": false,
        "expected_command": "python -m unittest discover tests",
        "expected_goal": "evaluation",
        "expected_status": "not_run",
        "expected_stdout_contains": "",
        "timeout_seconds": 60,
        "include_analysis_pass": true,
        "expected_metrics": []
      }
    },
    "pytorch-mnist": {
